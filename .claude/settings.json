{
  "model": "claude-opus-5-5",
  "router": {
    "enabled": true,
    "provider": "9router",
    "base_url": "http://localhost:20128",
    "api_version": "v1",
    "timeout_seconds": 30,
    "fallback_to_claude": true,
    "model_mapping": {
      "opusplan": "claude-opus-5-5"
    }
  },
  "lanes": {
    "default": {
      "executor": "claude",
      "model": "claude-opus-5-5",
      "route_through_router": true
    },
    "LANE:CHATGPT": {
      "executor": "codex",
      "model": "gpt-4-turbo",
      "route_through_router": false,
      "fallback_executor": "claude"
    },
    "LANE:DESIGN": {
      "executor": "claude",
      "model": "claude-opus-5-5",
      "route_through_router": true
    }
  },
  "hooks": {
    "session.post_end": [
      {
        "name": "post-session-compliance-check",
        "script": ".claude/hooks/post-session-compliance-check.sh",
        "description": "TRK-2026-9410: Enforce Rule 9 (task assignment governance) — flag unassigned tasks at session end",
        "enabled": true
      }
    ]
  }
}
