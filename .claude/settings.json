{
  "model": "claude-opus-5-5",
  "router": {
    "enabled": true,
    "provider": "9router",
    "base_url": "http://localhost:20128",
    "api_version": "v1",
    "timeout_seconds": 30,
    "fallback_to_claude": true,
    "model_mapping": {
      "opusplan": "claude-opus-5-5"
    }
  },
  "lanes": {
    "default": {
      "executor": "claude",
      "model": "claude-opus-5-5",
      "route_through_router": true
    },
    "LANE:CHATGPT": {
      "executor": "codex",
      "model": "gpt-4-turbo",
      "route_through_router": false,
      "fallback_executor": "claude"
    },
    "LANE:DESIGN": {
      "executor": "claude",
      "model": "claude-opus-5-5",
      "route_through_router": true
    }
  }
}
